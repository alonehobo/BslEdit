{
  "comment": "The single list of shared preview assets. Every host build reads this file; nothing else may hardcode these names. `scripts` is a load order, not a set: xml-util.js has to come first because the renderers alias its exports at load time.",
  "scripts": [
    "xml-util.js",
    "form-context.js",
    "form-preview.js",
    "template-preview.js",
    "mxl-preview.js",
    "metadata-preview.js",
    "metadata-relations.js",
    "xlsx-template.js",
    "template-markup.js",
    "form-edit.js",
    "form-validate.js",
    "providers.js"
  ],
  "comment2": "Optional scripts are built locally and git-ignored, because they are derived from 1C's own schemas and this repository is public. `before` keeps the load order when the file is there; without it the form editor works with no property checks.",
  "optionalScripts": [
    { "name": "form-item-properties.js", "before": "form-edit.js" }
  ],
  "styles": [
    "viewer.css"
  ],
